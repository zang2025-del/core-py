# Copy to .env and edit. Every value here has a working default, so an empty
# file is a valid configuration -- the two settings that are NOT safe by default
# are named for what they do rather than what they skip, because
# "dangerously skip permissions" is a phrase people learn to skim.

# ---- storage ---------------------------------------------------------------
# SQLite is the default: one file is the whole deployment. The storage layer is
# not SQLite-specific, and CI runs the whole suite against PostgreSQL, so either
# backend is a tested one rather than a supported one. A server database needs a
# driver: install the `postgres` extra and use postgresql+psycopg://.
PERMGATE_DATABASE_URL=sqlite+pysqlite:///./permgate.db
PERMGATE_DB_ECHO=false
# Create missing tables at startup. Leave it unset in production: unset means
# "SQLite only", because a server database's schema belongs to
# `alembic upgrade head` and two owners of one schema is one owner too many.
# PERMGATE_CREATE_SCHEMA_ON_STARTUP=false

# ---- the grant cache -------------------------------------------------------
# This is the only place in the service where a stale read is possible, so both
# knobs are exposed. Turning the cache off is a supported configuration, not a
# debug flag: "correct but slower" has to be available to whoever is chasing a
# live inconsistency.
PERMGATE_GRANT_CACHE_ENABLED=true
PERMGATE_GRANT_CACHE_TTL_SECONDS=15
PERMGATE_GRANT_CACHE_MAX_ENTRIES=4096

# ---- authentication --------------------------------------------------------
# On by default. With it off, POST /v1/grants writes a standing pre-approval for
# anyone who can reach the port, and project_root is whatever string the caller
# sent -- so naming a colleague's workspace is enough to inherit their grants.
#
# Turning it off is a deliberate act, not a shortcut: PERMGATE_AUTH_REQUIRED=false
# makes every request act as "anonymous".
PERMGATE_AUTH_REQUIRED=true

# The way into a fresh deployment: creates or refreshes a client named
# "bootstrap" at startup. Without a client the service refuses to start, which is
# the point -- but it does mean a new deployment needs one these two lines.
# Leave both unset once real clients exist; provision them with
# `permgate client create --name <label> --root <prefix>` instead, and treat the
# token as a secret (it is printed once, only a digest is stored).
# PERMGATE_AUTH_BOOTSTRAP_TOKEN=change-me-and-treat-as-a-secret
# Workspace prefixes that client may name, as a JSON list. Empty means it may
# name nothing.
# PERMGATE_AUTH_BOOTSTRAP_ROOTS=["/srv/checkouts"]

# ---- policy ----------------------------------------------------------------
PERMGATE_DEFAULT_RUN_MODE=interactive

# Command scopes an unattended run may use without asking, as a JSON list.
# Empty by default: a pre-approval that ships switched on is a pre-approval
# nobody chose. Example, for a Python CI pipeline:
#   PERMGATE_PREAPPROVED_SCOPES=["pip install -r","python -m pytest","git push"]
PERMGATE_PREAPPROVED_SCOPES=[]

# Off by default, and refused at the API edge rather than deep in the engine.
PERMGATE_ALLOW_BYPASS_MODE=false
# A client that can choose its own run mode can choose bypass, which would make
# the rest of the service decorative.
PERMGATE_ALLOW_CLIENT_SUPPLIED_MODE=false

# ---- audit -----------------------------------------------------------------
# Turning argument storage off keeps the digest, so a row still proves *which*
# call it was without storing something that may contain a secret.
PERMGATE_AUDIT_ENABLED=true
PERMGATE_AUDIT_STORE_ARGUMENTS=true

# ---- observability ---------------------------------------------------------
PERMGATE_LOG_LEVEL=INFO
PERMGATE_LOG_JSON=true
PERMGATE_METRICS_ENABLED=true

# ---- server ----------------------------------------------------------------
PERMGATE_HOST=127.0.0.1
PERMGATE_PORT=8000
PERMGATE_MAX_REQUEST_BYTES=1048576
